# Your Topmate.io login. Stored locally only — never committed, never sent anywhere
# other than topmate.io itself. Copy this file to `.env` and fill these in.
#
# Topmate has no password login — signing in emails you a one-time code, so
# there is no TOPMATE_PASSWORD. TOPMATE_EMAIL is used to request that code
# during browser-automated writes; TOPMATE_USERNAME (the part after

# Usually fine to leave as-is.
TOPMATE_BASE_URL=https://topmate.io
TOPMATE_API_BASE_URL=https://api.galactus.run

# Set to "false" once, the first time you need to watch the login happen
# (e.g. if Topmate shows a captcha or OTP the automated login can't get past).
# Leave "true" for normal day-to-day use.
HEADLESS=true
